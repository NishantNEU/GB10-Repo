# Copy to .env (git-ignored) and fill in. Every script sources this through scripts/env.sh.

# --- Telegram -------------------------------------------------------------
# Pitcrew agent bot: OpenClaw (inside NemoClaw) uses this one. Read by `nemoclaw onboard`.
TELEGRAM_BOT_TOKEN=
# Telegram user IDs allowed to DM the Pitcrew bot (comma-separated; the on-call engineer)
TELEGRAM_ALLOWED_IDS=
# Chat the agent posts incidents to (the engineer's DM with the Pitcrew bot = their user ID).
# Defaults to ONCALL_CHAT_ID if empty.
PITCREW_CHAT_ID=
# Separate "Pitcrew Approvals" bot: the tool server sends the one-time approval code
# straight to the on-call engineer, so the agent never sees it.
APPROVER_BOT_TOKEN=
# Telegram chat ID of the on-call engineer (send /start to the Approvals bot, then read getUpdates)
ONCALL_CHAT_ID=

# --- Ports and paths (shared contracts from timeline.md, section 1) ----------
TOOLSERVER_HOST=0.0.0.0
TOOLSERVER_PORT=9000
VLLM_PORT=8000
PITCREW_DB=data/pitcrew.db

# --- Model (operator-run vLLM from the kit) ----------------------------------
KIT_DIR=/home/dell/Desktop/Deploy_starter_kit
VLLM_IMAGE=nemoclaw-vllm:qwen36-gb10-arm64
VLLM_CONTAINER=pitcrew-vllm
VLLM_SERVED_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
VLLM_GPU_MEM_UTIL=0.5
VLLM_MAX_MODEL_LEN=65536

# --- NemoClaw ----------------------------------------------------------------
SANDBOX_NAME=pitcrew

# --- Test program (the only thing the agent may ever stop) -------------------
HOG_CONTAINER=pitcrew-test-hog
HOG_MEMORY_LIMIT=32g
HOG_STEP_GB=1
HOG_INTERVAL_S=3
HOG_MAX_GB=30
# The hog stops growing if host MemAvailable would drop below this.
HOG_MIN_FREE_GB=16

# --- Sample service (Data Engineer). Set from the real baseline (free -h with vLLM loaded).
MEM_THRESHOLD_GB=

# --- Demo tuning (common/config.py has the defaults) -------------------------
# DELAY_THRESHOLD_S=30        a job counts as delayed after waiting this long
# INCIDENT_MIN_DELAYED=5      detector opens an incident at this many delayed jobs
# JOB_INTERVAL_S=2  JOB_TIME_HEALTHY_S=1.5  JOB_TIME_DEGRADED_S=6
# APPROVAL_TTL_S=300  APPROVAL_MAX_ATTEMPTS=3
# TOOLSERVER_STUB=1           serve fixed JSON (agent testing before real data exists)

# --- Approval codes by email (preferred over the Approvals bot when all are set) ---------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=<gmail address>, SMTP_PASSWORD=<16-char app password>
#        (Google Account > Security > 2-Step Verification > App passwords). Port 587 works at the venue.
APPROVER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
